*.sim/
*.runs/
*.gen/
*.srcs/
webtalk*.jou
webtalk*.log
usage_statistics_webtalk.*

# -----------------------------------------------------------------------------
# TinyTapeout / OpenLane
# -----------------------------------------------------------------------------
runs/
src/tt/config_merged.json
src/tt/user_config.json
src/includes.v

# TT support tools (external repo)

# Scripts outputs
scripts/reports/
scripts/synth_generic.v

