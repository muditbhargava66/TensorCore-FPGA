!model/systemc/sa_model/memory.txt

# SPICE outputs (keep .cir source files)
model/spice/*.ps
model/spice/*.png
model/spice/*_data.txt

# -----------------------------------------------------------------------------
# Verilator Generated
# -----------------------------------------------------------------------------
obj_dir/
*.verilator

