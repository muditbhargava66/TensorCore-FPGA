# -----------------------------------------------------------------------------
*.vcd
*.fst
*.wave
*.fsdb
*.shm/
sim_result
sim_vpu
run_sa_test
verilator_test
*.vvp

# Cocotb
test/sim_build/
test/__pycache__/
test/results.xml

# SystemC
model/systemc/*/testbench
model/systemc/*/PE_Outputs/
